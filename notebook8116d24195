     axes[cls][j].axis('off')\n\n    plt.suptitle('Sample Images per Class', fontsize=16, fontweight='bold')\n    plt.tight_layout()\n    plt.savefig('sample_images.png', dpi=150, bbox_inches='tight')\n    plt.show()\n\nshow_samples(train_df, CFG.TRAIN_DIR)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-06T17:22:36.664915Z","iopub.execute_input":"2026-03-06T17:22:36.665280Z","iopub.status.idle":"2026-03-06T17:22:38.079909Z","shell.execute_reply.started":"2026-03-06T17:22:36.665246Z","shell.execute_reply":"2026-03-06T17:22:38.078717Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x700 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":6},{"cell_type":"code","source":"# ── Cell 7: Transforms (FIXED — tuple for RandomResizedCrop) ──────────────────\ndef get_transforms(phase, img_size=CFG.IMG_SIZE):\n    if phase == 'train':\n        return A.Compose([\n            A.RandomResizedCrop((img_size, img_size), scale=(0.8, 1.0)),\n            A.HorizontalFlip(p=0.5),\n            A.VerticalFlip(p=0.5),\n            A.Rotate(limit=30, p=0.5),\n            A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),\n            A.HueSaturationValue(hue_shift_limit=10, sat_shift_limit=20, p=0.3),\n            A.GaussianBlur(blur_limit=(3, 7), p=0.2),\n            A.CoarseDropout(max_holes=8, max_height=img_size//8, max_width=img_size//8, p=0.3),\n            A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n            ToTensorV2(),\n        ])\n    else:\n        return A.Compose([\n            A.Resize(img_size, img_size),\n            A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n            ToTensorV2(),\n        ])\n\ndef get_tta_transforms(img_size=CFG.IMG_SIZE):\n    return A.Compose([\n        A.Resize(img_size, img_size),\n        A.HorizontalFlip(p=0.5),\n        A.VerticalFlip(p=0.5),\n        A.Rotate(limit=15, p=0.5),\n        A.RandomBrightnessContrast(0.1, 0.1, p=0.3),\n        A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n        ToTensorV2(),\n    ])\n\nprint('Transforms defined ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-06T17:22:38.081283Z","iopub.execute_input":"2026-03-06T17:22:38.081530Z","iopub.status.idle":"2026-03-06T17:22:38.091814Z","shell.execute_reply.started":"2026-03-06T17:22:38.081508Z","shell.execute_reply":"2026-03-06T17:22:38.090879Z"}},"outputs":[{"name":"stdout","text":"Transforms defined ✓\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# ── Cell 8: Dataset ───────────────────────────────────────────────────────────\nclass CancerDataset(Dataset):\n    def __init__(self, df, img_dir, transform=None, has_labels=True):\n        self.df         = df.reset_index(drop=True)\n        self.img_dir    = Path(img_dir)\n        self.transform  = transform\n        self.has_labels = has_labels\n\n    def _find_image(self, image_id):\n        for ext in ['.jpg', '.jpeg', '.png', '.tif', '.tiff', '']:\n            p = self.img_dir / f'{image_id}{ext}'\n            if p.exists():\n                return p\n        raise FileNotFoundError(f'Image not found: {image_id}')\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row      = self.df.iloc[idx]\n        img_path = self._find_image(row['image_id'])\n        image    = np.array(Image.open(img_path).convert('RGB'))\n        if self.transform:\n            image = self.transform(image=image)['image']\n        if self.has_labels:\n            return image, torch.tensor(row['label'], dtype=torch.float32)\n        return image\n\nprint('Dataset class defined ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-06T17:22:38.092946Z","iopub.execute_input":"2026-03-06T17:22:38.093399Z","iopub.status.idle":"2026-03-06T17:22:38.108756Z","shell.execute_reply.started":"2026-03-06T17:22:38.093375Z","shell.execute_reply":"2026-03-06T17:22:38.107917Z"}},"outputs":[{"name":"stdout","text":"Dataset class defined ✓\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# ── Cell 9: Model Architecture ────────────────────────────────────────────────\nclass CancerClassifier(nn.Module):\n    def __init__(self, model_name, pretrained=True, dropout=0.3):\n        super().__init__()\n        self.backbone = timm.create_model(model_name, pretrained=pretrained, num_classes=0)\n        in_features   = self.backbone.num_features\n        self.head = nn.Sequential(\n            nn.Linear(in_features, 512),\n            nn.BatchNorm1d(512),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(512, 128),\n            nn.ReLU(),\n            nn.Dropout(dropout / 2),\n            nn.Linear(128, 1)\n        )\n\n    def forward(self, x):\n        return self.head(self.backbone(x)).squeeze(1)\n\n# Sanity check\nmodel = CancerClassifier('efficientnet_b4').to(DEVICE)\ndummy = torch.randn(2, 3, CFG.IMG_SIZE, CFG.IMG_SIZE).to(DEVICE)\nout   = model(dummy)\nprint(f'Model output shape: {out.shape}  ✓')\ndel model, dummy, out\ntorch.cuda.empty_cache()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-06T17:22:38.109802Z","iopub.execute_input":"2026-03-06T17:22:38.110828Z","iopub.status.idle":"2026-03-06T17:22:39.066569Z","shell.execute_reply.started":"2026-03-06T17:22:38.110803Z","shell.execute_reply":"2026-03-06T17:22:39.065775Z"}},"outputs":[{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"name":"stdout","text":"Model output shape: torch.Size([2])  ✓\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"# ── Cell 10: Training & Validation Functions ──────────────────────────────────\ndef train_one_epoch(model, loader, optimizer, criterion, scaler):\n    model.train()\n    total_loss, preds_all, labels_all = 0.0, [], []\n    for images, labels in loader:\n        images, labels = images.to(DEVICE), labels.to(DEVICE)\n        optimizer.zero_grad()\n        with torch.cuda.amp.autocast():\n            logits = model(images)\n            loss   = criterion(logits, labels)\n        scaler.scale(loss).backward()\n        scaler.unscale_(optimizer)\n        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        scaler.step(optimizer)\n        scaler.update()\n        total_loss += loss.item() * len(labels)\n        preds_all.extend(torch.sigmoid(logits).detach().cpu().numpy())\n        labels_all.extend(labels.cpu().numpy())\n    return total_loss / len(loader.dataset), roc_auc_score(labels_all, preds_all)\n\n@torch.no_grad()\ndef validate(model, loader, criterion):\n    model.eval()\n    total_loss, preds_all, labels_all = 0.0, [], []\n    for images, labels in loader:\n        images, labels = images.to(DEVICE), labels.to(DEVICE)\n        with torch.cuda.amp.autocast():\n            logits = model(images)\n            loss   = criterion(logits, labels)\n        total_loss += loss.item() * len(labels)\n        preds_all.extend(torch.sigmoid(logits).cpu().numpy())\n        labels_all.extend(labels.cpu().numpy())\n    return total_loss / len(loader.dataset), roc_auc_score(labels_all, preds_all)\n\nprint('Training functions defined ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-06T17:22:39.067546Z","iopub.execute_input":"2026-03-06T17:22:39.067895Z","iopub.status.idle":"2026-03-06T17:22:39.076869Z","shell.execute_reply.started":"2026-03-06T17:22:39.067849Z","shell.execute_reply":"2026-03-06T17:22:39.076207Z"}},"outputs":[{"name":"stdout","text":"Training functions defined ✓\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# ── Cell 11: Prediction Helpers ───────────────────────────────────────────────\n@torch.no_grad()\ndef get_val_preds(model, loader):\n    model.eval()\n    preds = []\n    for images, _ in loader:\n        images = images.to(DEVICE)\n        with torch.cuda.amp.autocast():\n            logits = model(images)\n        preds.extend(torch.sigmoid(logits).cpu().numpy())\n    return np.array(preds)\n\n@torch.no_grad()\ndef get_test_preds_tta(model, test_df):\n    model.eval()\n    all_preds = []\n    for _ in range(CFG.TTA_STEPS):\n        ds     = CancerDataset(test_df, CFG.TEST_DIR, get_tta_transforms(), has_labels=False)\n        loader = DataLoader(ds, batch_size=CFG.BATCH_SIZE * 2, shuffle=False,\n                            num_workers=CFG.NUM_WORKERS, pin_memory=True)\n        preds = []\n        for images in loader:\n            images = images.to(DEVICE)\n            with torch.cuda.amp.autocast():\n                logits = model(images)\n            preds.extend(torch.sigmoid(logits).cpu().numpy())\n        all_preds.append(np.array(preds))\n    return np.mean(all_preds, axis=0)\n\nprint('Prediction helpers defined ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-06T17:22:39.078607Z","iopub.execute_input":"2026-03-06T17:22:39.078931Z","iopub.status.idle":"2026-03-06T17:22:39.095204Z","shell.execute_reply.started":"2026-03-06T17:22:39.078910Z","shell.execute_reply":"2026-03-06T17:22:39.094383Z"}},"outputs":[{"name":"stdout","text":"Prediction helpers defined ✓\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"def run_fold(fold, model_name, train_df, oof_preds, test_preds_list):\n    print(f'\\n{\"=\"*50}')\n    print(f'  MODEL: {model_name} | FOLD {fold+1}/{CFG.N_FOLDS}')\n    print(f'{\"=\"*50}')\n\n    skf = StratifiedKFold(n_splits=CFG.N_FOLDS, shuffle=True, random_state=SEED)\n    splits = list(skf.split(train_df, train_df['label']))\n    train_idx, val_idx = splits[fold]\n\n    train_fold = train_df.iloc[train_idx]\n    val_fold   = train_df.iloc[val_idx]\n    print(f'Train: {len(train_fold)} | Val: {len(val_fold)}')\n\n  